# Copie ce fichier en .env.local (jamais commité) et remplis les deux valeurs.
# Elles se trouvent dans Supabase : Project Settings > API Keys.

# Adresse du projet Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé « publishable » (sb_publishable_...). Elle est faite pour être publique : ce sont
# les règles d'accès de la base qui protègent les données. Ne JAMAIS mettre ici la clé
# « secret » ou « service_role ».
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx

# Optionnel, pour les tests et la démo : « memory » remplace Supabase par des données
# gardées dans le navigateur. À ne pas définir en production.
# VITE_BACKEND=memory
